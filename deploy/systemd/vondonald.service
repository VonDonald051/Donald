[Unit]
Description=VonDonald Savings System
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=vondonald
Group=vondonald
WorkingDirectory=/opt/vondonald-system
EnvironmentFile=/etc/vondonald/vondonald.env
ExecStart=/usr/bin/node /opt/vondonald-system/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/vondonald-system/database/data /opt/vondonald-system/database/uploads
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
