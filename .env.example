# Reference only. Inject these values through systemd/container/orchestrator secrets.
# The app does not automatically load .env files.

# Production listener: loopback only, behind a trusted HTTPS reverse proxy.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
# Comma-separated exact browser origins only. Leave empty for same-origin hosting.
# Local split-port example: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Login factors. Production startup requires phone OTP for both password and Google login.
LOGIN_PHONE_OTP_ENABLED=1
# Google OAuth Web client. Register this exact URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
# Twilio Verify credentials. The Verify service must support SMS in members' countries.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Alternative bootstrap for an empty database; prefer `node provision-owner.js`.
# If used, inject these through a secret manager. Never store the password in this file.
OWNER_FIRST_NAME=
OWNER_LAST_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=

# Required: encryption keys must be independently generated and injected by the secret manager.
# DB_ENCRYPTION_KEY protects the JSON database (AES-256-GCM).
DB_ENCRYPTION_KEY=

# PHP/Vercel migration: provision PostgreSQL in Vercel Storage/Marketplace, then
# set DATABASE_URL in the Vercel project environment. Locally, leave it blank to
# keep using the encrypted JSON file until the migration window.
DATABASE_URL=

# Temporary bridge for verifying legacy Node scrypt password hashes.
# Generate a random 32-byte secret (64 hex characters) and set the same value
# in both PHP and Node Vercel Functions. Keep the real value in .env locally and
# Vercel's encrypted environment settings in production; never commit it.
LEGACY_SCRYPT_BRIDGE_SECRET=
# Local development: http://127.0.0.1:3000/api/legacy-scrypt-verify.
# Vercel may leave this blank to derive the URL from its VERCEL_URL setting.
LEGACY_SCRYPT_VERIFY_URL=

# Encrypted maintenance backups and reset scripts. Inject via the service manager,
# not a checked-in .env file. SYSTEM_BACKUP_PATH must point outside this app.
SYSTEM_BACKUP_KEY=
SYSTEM_BACKUP_PATH=
SYSTEM_PRE_RESTORE_BACKUP_PATH=
# Set to 1 only for a planned, confirmed maintenance operation.
ENABLE_DESTRUCTIVE_MAINTENANCE=0
# Reset script only; use a secret manager and rotate immediately after reset.
OWNER_INITIAL_PASSWORD=

# Agreement V2. Keep issuance disabled until the migration and secret are deployed.
SYSTEM_AGREEMENTS_V2=0
AGREEMENT_CODE_HMAC_KEY=
AGREEMENT_PENDING_TTL_DAYS=30
AGREEMENT_PDF_SEAL_KEY=
AGREEMENT_STORAGE_KEY=
AGREEMENT_VERIFY_BASE_URL=
# Handwritten signature scans require Poppler, ZBar QR scanning, and ClamAV; override paths if needed.
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
AGREEMENT_QRSCAN_BIN=zbarimg
AGREEMENT_CLAMSCAN_BIN=clamscan

# Chat ciphertext is retained for this many days (1–3650); default is 365.
CHAT_RETENTION_DAYS=365
WS_MAX_CONNECTIONS=1000
ENABLE_SCHEMA_MIGRATIONS=0
ENABLE_DATA_ENCRYPTION_MIGRATION=0

# Production requires working SMTP for security alerts.
# Example: Gmail / Google Workspace (use an App Password, not your real password)
# SMTP_URL=smtps://josilimong@gmail.com:your-app-password@smtp.gmail.com:465
# Option A: smtps://user:pass@smtp.example.com:465
# SMTP_URL=
# Option B:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=josilimong@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="VonDonald051 Savings <no-reply@josilimong@gmail.com>"

# Optional Teams webhook for security alerts. Keep its value in a secret manager.
# TEAMS_WEBHOOK_URL=

# Optional AI provider for security alert analysis (OpenAI-compatible endpoint).
# When set, security alerts are enriched with AI-generated severity and recommendations.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
